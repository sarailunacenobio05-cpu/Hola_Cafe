# CONFIGURACIÓN DEL SERVIDOR
server.port=8080
server.servlet.context-path=/api

# CONEXIÓN A BASE DE DATOS MYSQL (Local XAMPP / MySQL nativo)
spring.datasource.url=jdbc:mysql://localhost:3306/holacafe_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&characterEncoding=UTF-8
spring.datasource.username=root
# En XAMPP la contraseña por defecto de root suele ser vacía.
# Si configuraste una en tu MySQL Server, colócala aquí:
spring.datasource.password=
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# CONFIGURACIÓN JPA / HIBERNATE
# Rúbrica: Prohibido ddl-auto=create. Usamos validate para verificar tablas.
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect

# MIGRACIONES CON FLYWAY (Exigido en rúbrica)
spring.flyway.enabled=true
spring.flyway.locations=classpath:db/migration
spring.flyway.baseline-on-migrate=true
spring.flyway.validate-on-migrate=true

# SEGURIDAD Y JWT (JSON Web Token)
# Clave secreta HMAC-SHA de al menos 256 bits (32 bytes) codificada en Base64
jwt.secret=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
jwt.expiration-ms=86400000

# TWILIO (SMS Y WHATSAPP)
twilio.account-sid=AC_PLACEHOLDER_TWILIO_SID
twilio.auth-token=PLACEHOLDER_TWILIO_AUTH_TOKEN
twilio.phone-number=+1234567890
twilio.whatsapp-number=whatsapp:+14155238886

# CONFIGURACIÓN DE CORREO (JavaMailSender / Postfix local en VPS)
spring.mail.host=localhost
spring.mail.port=25
spring.mail.properties.mail.smtp.auth=false
spring.mail.properties.mail.smtp.starttls.enable=false
mail.from=noreply@holacafe.com
